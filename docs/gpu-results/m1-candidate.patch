+def qsat_delta(tair: float, delta: float, ps: float) -> float:
+    """Tetens evaluation without first rounding tair + delta to Kelvin."""
+    tc = (tair - 273.15) + delta
+    es = 611.2 * np.exp(17.67 * tc / (tc + 243.5))
+    return 0.622 * es / max(1.0, ps - 0.378 * es)
+
+
+def temperature_fourth_delta(tair: float, delta: float) -> float:
+    """Exact quartic expansion about air temperature (no linearization)."""
+    t2 = tair * tair
+    return t2 * t2 + delta * (4.0 * tair * t2 + delta * (6.0 * t2 + delta * (4.0 * tair + delta)))
+
+
